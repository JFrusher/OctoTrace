# Copy to .env. Leave the three OCTOPUS_* credentials blank to run on generated mock data.

# Octopus dashboard -> Personal details -> API access (https://octopus.energy/dashboard/new/accounts/personal-details/api-access)
OCTOPUS_API_KEY=
# 13-digit electricity import MPAN and meter serial (shown on the same API access page)
OCTOPUS_MPAN=
OCTOPUS_METER_SERIAL=
# Your Agile tariff code; the last letter is your region (A-P)
OCTOPUS_TARIFF_CODE=E-1R-AGILE-24-10-01-C

# Comparison baseline: flat SVT unit rate (p/kWh inc VAT) and daily standing charge (p/day)
SVT_RATE_PENCE=24.5
STANDING_CHARGE_PENCE=50

# SQLite file (relative to project root)
DATABASE_URL=file:./dev.db
